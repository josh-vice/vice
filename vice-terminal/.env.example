# Server-side beta auth remains the only hosted control-plane configuration.

# Durable server-only closed-beta gate. Production/mainnet requires all
# values; invite codes are HMAC-hashed before storage in Upstash Redis.
VICE_BETA_REQUIRED=false
# VICE_BETA_SESSION_SECRET=replace-with-a-long-random-secret
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=replace-with-server-secret
# VICE_BETA_ACCESS_CODES is legacy local-development-only configuration.

# Runtime release policy is server-only JSON; it must never use VITE_*.
# VICE_RELEASE_POLICY_JSON={\"releaseBuild\":\"...\",\"network\":\"mainnet\",\"enabled\":true,\"halted\":false,\"policyVersion\":\"...\",\"allowedActionIds\":[],\"allowedOrderFamilies\":[],\"allowedVenues\":[],\"allowedWallets\":[],\"perOrderCapUsd\":\"0\",\"aggregateCapUsd\":\"0\",\"expiresAt\":0,\"approvalSha256\":\"\"}
# VICE_MAINNET_RELEASE_BUILD=full-commit-bound-build
# VICE_BETA_SUPPORT_OWNER=...
# VICE_INCIDENT_OWNER=...
# VICE_RELEASE_OWNER=...

# Hyperliquid public market data. Mainnet is read-only and does not unlock trading.
VITE_HL_PUBLIC_NETWORK=mainnet
# Hyperliquid account and execution network. The beta is mainnet-only.
VITE_HL_TRADING_NETWORK=mainnet
# A trading-network mainnet requires both:
# VITE_HL_MAINNET_ACK=I_ACCEPT_REAL_MAINNET_TRADING

# Optional revenue onboarding. Builder fees require explicit wallet approval.
# 0.1 bp is attached to orders only after approval succeeds.
# VITE_HL_BUILDER_ADDRESS=0x...
# Revenue is fail-closed until this explicit opt-in is enabled.
# VITE_HL_ENABLE_BUILDER_REVENUE=false
# VITE_HL_REFERRAL_CODE=...

# Optional: set to true only when you explicitly want demo account fixtures.
VITE_ENABLE_DEMO_FIXTURES=false

# Advanced order certification is fail-closed. The global flag can enable a
# certified batch, while any per-type false override keeps that strategy hidden
# until its own funded-mainnet lifecycle and reconnect evidence is complete.
# Brackets remain gated separately because Hyperliquid normalTpsl uses fixed-size
# TP/SL children for the entry group and requires funded partial-fill verification.
# VITE_HL_CERTIFIED_BRACKET=false
# VITE_HL_CERTIFIED_ADVANCED_ORDERS=false
# VITE_HL_CERTIFIED_TWAP=false
# VITE_HL_CERTIFIED_ADAPTIVE_TWAP=false
# VITE_HL_CERTIFIED_VWAP=false
# VITE_HL_CERTIFIED_POV=false
# VITE_HL_CERTIFIED_BREAK_EVEN=false
# VITE_HL_CERTIFIED_MAKER=false
# VITE_HL_CERTIFIED_CONDITIONAL_LADDER=false
# VITE_HL_CERTIFIED_VOLATILITY_SIZING=false
# VITE_HL_CERTIFIED_SCALE=false
# VITE_HL_CERTIFIED_CHASE=false
# VITE_HL_CERTIFIED_SWARM=false
# VITE_HL_CERTIFIED_ICEBERG=false
# VITE_HL_CERTIFIED_OCO=false
# VITE_HL_CERTIFIED_PING_PONG=false
# VITE_HL_CERTIFIED_TRAILING_STOP=false
