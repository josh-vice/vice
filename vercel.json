{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/gen-seo.js && node tools/gen-academy.js",
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?vicesuite\\.com"
        }
      ],
      "destination": "/vice/index.html"
    },
    {
      "source": "/chartbot",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?vicesuite\\.com"
        }
      ],
      "destination": "/vice/charts/index.html"
    },
    {
      "source": "/pricebots",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?vicesuite\\.com"
        }
      ],
      "destination": "/vice/tickers/index.html"
    },
    {
      "source": "/hub",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?vicesuite\\.com"
        }
      ],
      "destination": "/vice/hub/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?vicesuite\\.com"
        }
      ],
      "destination": "/vice/:path*"
    },
    {
      "source": "/academy",
      "destination": "/academy/index.html"
    },
    {
      "source": "/academy/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/blofintest",
      "destination": "/blofintest/index.html"
    },
    {
      "source": "/blofintest/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/academy",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).(svg|png|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/academy",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?vicesuite\\.com"
        }
      ],
      "destination": "https://liqtheory.com/academy",
      "permanent": false
    }
  ]
}
