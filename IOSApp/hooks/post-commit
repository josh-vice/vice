#!/bin/bash
# Auto-sync the website into the iOS app bundle after every commit.
# Tracked copy lives at IOSApp/hooks/post-commit; the live hook is
# .git/hooks/post-commit (git hooks are local-only, so re-install on a
# fresh clone with:  cp IOSApp/hooks/post-commit .git/hooks/ && chmod +x .git/hooks/post-commit)
ROOT="$(git rev-parse --show-toplevel)"
SYNC="$ROOT/IOSApp/sync-www.sh"
if [ -x "$SYNC" ]; then
  if "$SYNC" >/dev/null 2>&1; then
    echo "[post-commit] iOS app bundle synced from website"
  else
    echo "[post-commit] iOS sync FAILED — run IOSApp/sync-www.sh manually to see the error"
  fi
fi
